# AgroDex Mobile — Environment Variable Template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it to version control.
#
# ⚠️  SECURITY WARNING ⚠️
# Only the ANON (publishable) key belongs here.
# SUPABASE_SERVICE_ROLE_KEY is for server-side backend use ONLY.
# Adding a service role key to a mobile app is a critical security vulnerability.

# Supabase (anon/publishable key only)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AgroDex Backend API
VITE_API_BASE_URL=https://agro-dex-nine.vercel.app

# Hedera / Mirror Node
VITE_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
VITE_HEDERA_NETWORK=testnet

# WalletConnect
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
